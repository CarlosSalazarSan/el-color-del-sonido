// ======================================================
// ENTRENADOR DE OÍDO - NOTAS Y COLORES (p5.js + p5.sound)
// ======================================================

// ----------------- ESTADOS DEL JUEGO ------------------
const STATE_INTRO      = 0; // pantallas grises iniciales
const STATE_NOTE_INTRO = 1; // presentación de la nueva nota del nivel
const STATE_PLAYING    = 2; // juego normal
const STATE_FEEDBACK   = 3; // pantalla de acierto/error
const STATE_FINISHED   = 4; // juego terminado

let state = STATE_INTRO;

// ----------------- PANTALLAS INTRO --------------------
let introTexts = [
  "Bienvenido/a.\n\n" +
  "Este juego te ayuda a asociar notas\n" +
  "musicales con colores.\n\n" +
  "Escucharás una nota y tendrás que\n" +
  "elegir el botón con el color correcto.",

  "Cada nivel añade una nota nueva.\n\n" +
  "Acertar 5 veces en un nivel te hace\n" +
  "pasar al siguiente.\n\n" +
  "En el último nivel ya no verás el\n" +
  "nombre de la nota, sólo el color."
];

let introPage = 0;

// ----------------- NOTAS Y COLORES --------------------
let notas = ["DO", "RE", "MI", "FA", "SOL", "LA", "SI"];
let colores = []; // se rellenará en setup()

// ----------------- NIVELES ----------------------------
let level = 0;          // 0..7
let maxLevel = 7;
let correctInLevel = 0; // aciertos en nivel actual
let neededPerLevel = 5; // aciertos necesarios por nivel

let currentNoteIndex = 0; // índice de nota objetivo (0..6)
let optionsCount = 1;     // nº de botones de nota visibles

let lastAnswerCorrect = false;
let leveledUp = false;

// ----------------- BOTONES ----------------------------
let noteButtons = new Array(7);
let replayButton;
let introButton;
let restartButton;

// ----------------- SONIDO -----------------------------
let sonidos = new Array(7);

// ======================================================
// PRELOAD - CARGA DE SONIDOS
// ======================================================
function preload() {
  // Cargar archivo musical
  for (let i = 0; i < notas.length; i++) {
    let fileName = `sonidos/${notas[i]}.wav`;
    try {
      sonidos[i] = loadSound(fileName, () => {
        console.log("Cargado:", fileName);
      }, (err) => {
        console.warn("No se pudo cargar", fileName);
        sonidos[i] = null;
      });
    } catch (e) {
      console.warn("Error al intentar cargar", fileName, e);
      sonidos[i] = null;
    }
  }
}

// ======================================================
// SETUP
// ======================================================
function setup() {
  createCanvas(900, 600);
  textAlign(CENTER, CENTER);

  // Colores de las notas (como en Processing)
  let DOc  = color(255, 75, 75);   // rojo
  let REc  = color(255, 158, 61);  // naranja
  let MIc  = color(255, 217, 61);  // amarillo
  let FAc  = color(75, 203, 91);   // verde
  let SOLc = color(53, 208, 200);  // turquesa
  let LAc  = color(75, 123, 255);  // azul
  let SIc  = color(165, 91, 255);  // violeta

  colores = [DOc, REc, MIc, FAc, SOLc, LAc, SIc];

  // Creamos los botones de nota (posición se ajusta en drawPlaying)
  let dummyX = 0;
  let dummyY = 0;
  let dummyW = 100;
  let dummyH = 80;
  for (let i = 0; i < 7; i++) {
    noteButtons[i] = new Button(
      dummyX,
      dummyY,
      dummyW,
      dummyH,
      notas[i],
      colores[i],
      i
    );
  }

  // Botón repetir nota (posición se ajusta según el estado)
  replayButton = new Button(
    width / 2 - 90,
    height / 2 + 40,
    180,
    50,
    "Repetir nota",
    color(200),
    -1
  );

  // Botón intro / empezar / continuar
  introButton = new Button(
    width / 2 - 80,
    height - 120,
    160,
    50,
    "Siguiente",
    color(200),
    -1
  );

  // Botón reiniciar
  restartButton = new Button(
    width / 2 - 80,
    height - 150,
    160,
    50,
    "Reiniciar",
    color(200),
    -1
  );
}

// ======================================================
// DRAW
// ======================================================
function draw() {
  switch (state) {
    case STATE_INTRO:
      drawIntro();
      break;
    case STATE_NOTE_INTRO:
      drawNoteIntro();
      break;
    case STATE_PLAYING:
      drawPlaying();
      break;
    case STATE_FEEDBACK:
      drawFeedback();
      break;
    case STATE_FINISHED:
      drawFinished();
      break;
  }
}

// ======================================================
// DIBUJO DE CADA ESTADO
// ======================================================

function drawIntro() {
  background(80);

  fill(255);
  textSize(26);
  text("Entrenador de oído - Notas y colores", width / 2, 60);

  textSize(20);
  fill(230);
  text(introTexts[introPage], width / 2, height / 2 - 40);

  introButton.label = (introPage < introTexts.length - 1) ? "Siguiente" : "Listo";
  introButton.x = width / 2 - 80;
  introButton.y = height - 120;
  introButton.w = 160;
  introButton.h = 50;
  introButton.draw(true);
}

// Presentación de la nueva nota del nivel
function drawNoteIntro() {
  background(colores[currentNoteIndex]);

  // Panel superior semitransparente
  noStroke();
  fill(0, 150);
  rect(0, 0, width, 150);

  fill(255);
  textSize(28);
  text("Nivel " + level, width / 2, 40);

  textSize(22);
  text("Nueva nota en este nivel:", width / 2, 80);

  textSize(40);
  text(notas[currentNoteIndex], width / 2, 125);

  // Botón escuchar nota
  replayButton.x = width / 2 - 100;
  replayButton.y = height / 2 + 10;
  replayButton.w = 200;
  replayButton.h = 55;
  replayButton.label = "Escuchar nota";
  replayButton.draw(true);

  // Botón empezar nivel
  introButton.label = "Empezar nivel";
  introButton.x = width / 2 - 100;
  introButton.y = height / 2 + 90;
  introButton.w = 200;
  introButton.h = 55;
  introButton.draw(true);
}

function drawPlaying() {
  // Fondo neutro
  background(60);

  // Barra superior
  noStroke();
  fill(0, 150);
  rect(0, 0, width, 120);

  fill(255);
  textSize(28);
  text("Nivel " + level, width / 2, 35);

  textSize(18);
  text(
    "Aciertos en este nivel: " + correctInLevel + " / " + neededPerLevel,
    width / 2,
    75
  );

  textSize(16);
  text(
    "Escucha la nota y pulsa el botón del color correcto.",
    width / 2,
    105
  );

  // Botones centrados
  let mostrarNombres = (level < 7);

  let btnWidth = 90;
  let btnHeight = 80;
  let gap = 15;
  let totalWidth = optionsCount * btnWidth + (optionsCount - 1) * gap;
  let startX = width / 2 - totalWidth / 2;
  let y = height - 160;

  for (let i = 0; i < optionsCount; i++) {
    let b = noteButtons[i];
    b.x = startX + i * (btnWidth + gap);
    b.y = y;
    b.w = btnWidth;
    b.h = btnHeight;
    b.draw(mostrarNombres);
  }

  // Botón repetir nota encima de los botones
  replayButton.x = width / 2 - 100;
  replayButton.y = y - 100;
  replayButton.w = 200;
  replayButton.h = 55;
  replayButton.label = "Repetir nota";
  replayButton.draw(true);
}

function drawFeedback() {
  if (lastAnswerCorrect) {
    background(60, 170, 80);
  } else {
    background(190, 60, 60);
  }

  fill(255);
  textSize(36);
  text(
    lastAnswerCorrect ? "¡Correcto!" : "¡Ups!",
    width / 2,
    height / 2 - 40
  );

  textSize(22);
  if (lastAnswerCorrect) {
    text(
      "Aciertos en este nivel: " + correctInLevel + " / " + neededPerLevel,
      width / 2,
      height / 2 + 10
    );
  } else {
    text(
      "La nota correcta era: " + notas[currentNoteIndex],
      width / 2,
      height / 2 + 10
    );
  }

  if (leveledUp) {
    text("¡Has pasado al nivel " + level + "!", width / 2, height / 2 + 60);
  }

  textSize(18);
  text("Haz clic para continuar.", width / 2, height - 80);
}

function drawFinished() {
  background(30, 30, 60);

  fill(255);
  textSize(32);
  text("¡Enhorabuena!", width / 2, height / 2 - 60);

  textSize(22);
  text("Has completado todos los niveles.", width / 2, height / 2);

  textSize(18);
  text(
    "Puedes volver a empezar si quieres practicar más.",
    width / 2,
    height / 2 + 40
  );

  restartButton.x = width / 2 - 80;
  restartButton.y = height - 150;
  restartButton.w = 160;
  restartButton.h = 50;
  restartButton.draw(true);
}

// ======================================================
// LÓGICA DE JUEGO
// ======================================================

function startGame() {
  level = 0;
  correctInLevel = 0;
  showNoteIntroForLevel();
}

// Presentación de la nueva nota del nivel
function showNoteIntroForLevel() {
  currentNoteIndex = Math.min(level, notas.length - 1);
  optionsCount = Math.min(level + 1, 7);
  playCurrentNote();
  state = STATE_NOTE_INTRO;
}

function newRound() {
  optionsCount = Math.min(level + 1, 7);
  currentNoteIndex = Math.floor(random(optionsCount));
  playCurrentNote();
}

function handleAnswer(clickedNoteIndex) {
  leveledUp = false;
  lastAnswerCorrect = (clickedNoteIndex === currentNoteIndex);

  if (lastAnswerCorrect) {
    correctInLevel++;

    if (correctInLevel >= neededPerLevel) {
      if (level < maxLevel) {
        level++;
        correctInLevel = 0;
        leveledUp = true;
      } else {
        state = STATE_FINISHED;
        return;
      }
    }
  }

  state = STATE_FEEDBACK;
}

// ======================================================
// INPUT RATÓN
// ======================================================

function mousePressed() {
  switch (state) {
    case STATE_INTRO:
      if (introButton.isMouseOver()) {
        if (introPage < introTexts.length - 1) {
          introPage++;
        } else {
          startGame();
        }
      }
      break;

    case STATE_NOTE_INTRO:
      if (replayButton.isMouseOver()) {
        playCurrentNote();
      } else if (introButton.isMouseOver()) {
        state = STATE_PLAYING;
        newRound();
      }
      break;

    case STATE_PLAYING:
      if (replayButton.isMouseOver()) {
        playCurrentNote();
        return;
      }
      for (let i = 0; i < optionsCount; i++) {
        if (noteButtons[i].isMouseOver()) {
          handleAnswer(noteButtons[i].noteIndex);
          break;
        }
      }
      break;

    case STATE_FEEDBACK:
      if (leveledUp) {
        leveledUp = false;
        showNoteIntroForLevel();
      } else {
        state = STATE_PLAYING;
        newRound();
      }
      break;

    case STATE_FINISHED:
      if (restartButton.isMouseOver()) {
        startGame();
      }
      break;
  }
}

// ======================================================
// CLASE BUTTON
// ======================================================

class Button {
  constructor(x, y, w, h, label, fondo, noteIndex) {
    this.x = x;
    this.y = y;
    this.w = w;
    this.h = h;
    this.label = label;
    this.fondo = fondo;
    this.noteIndex = noteIndex; // -1 si no hay nota asociada
  }

  draw(showLabel) {
    let over = this.isMouseOver();
    let c = this.fondo;

    if (over) {
      // aclarar un poco el color al pasar el ratón
      c = lerpColor(this.fondo, color(255), 0.15);
    }

    // Borde negro
    stroke(0);
    strokeWeight(over ? 3 : 2);
    fill(c);
    rect(this.x, this.y, this.w, this.h, 15);

    if (showLabel && this.label) {
      fill(255);
      textSize(18);
      textAlign(CENTER, CENTER);
      text(this.label, this.x + this.w / 2, this.y + this.h / 2);
    }
  }

  isMouseOver() {
    return (
      mouseX >= this.x &&
      mouseX <= this.x + this.w &&
      mouseY >= this.y &&
      mouseY <= this.y + this.h
    );
  }
}

// ======================================================
// SONIDO
// ======================================================

function playCurrentNote() {
  let s = sonidos[currentNoteIndex];
  if (s && s.isLoaded()) {
    if (s.isPlaying()) {
      s.stop();
    }
    s.play();
  } else {
    console.log("Sonido no cargado para", notas[currentNoteIndex]);
  }
}
